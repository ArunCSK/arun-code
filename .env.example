# NVIDIA NIM API key (required)
NVIDIA_BEARER=your_nvidia_api_key_here

# Model to use (optional, defaults to google/diffusiongemma-26b-a4b-it)
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# Model used for `ac agent` (tool-calling / file+shell tasks). Must support
# OpenAI-style function calling on NIM. Defaults to NVIDIA_MODEL if unset,
# but the default chat model above does NOT support tool calling, so set
# this explicitly, e.g.:
# NVIDIA_AGENT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_AGENT_MODEL=meta/llama-3.1-70b-instruct

# NIM endpoint base URL (optional, defaults to https://integrate.api.nvidia.com/v1/chat/completions)
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
